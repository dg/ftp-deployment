{
	"name": "dg/ftp-deployment",
	"type": "project",
	"description": "🚚 FTP Deployment: deploys web applications to FTP or SFTP, uploading only the files that changed and switching them in at the end, so the site is never half-updated.",
	"keywords": ["deployment", "deploy", "ftp", "sftp", "ftps"],
	"homepage": "https://github.com/dg/ftp-deployment",
	"license": ["BSD-3-Clause", "GPL-2.0-only", "GPL-3.0-only"],
	"authors": [
		{
			"name": "David Grudl",
			"homepage": "https://davidgrudl.com"
		}
	],
	"require": {
		"php": ">=8.2",
		"ext-zlib": "*",
		"phpseclib/phpseclib": "^3.0"
	},
	"require-dev": {
		"nette/tester": "^2.0",
		"phpstan/phpstan": "^2.1",
		"phpstan/extension-installer": "^1.4",
		"nette/phpstan-rules": "^1.0"
	},
	"suggest": {
		"ext-ftp": "to connect to ftp:// server",
		"ext-openssl": "to connect to ftps:// server and preprocess CSS files",
		"ext-ssh2": "to connect to sftp:// server",
		"ext-json": "to preprocess CSS files via online service"
	},
	"autoload": {
		"classmap": ["src/"]
	},
	"bin": ["deployment"],
	"scripts": {
		"phpstan": "phpstan analyse",
		"tester": "tester tests -s"
	},
	"extra": {
		"branch-alias": {
			"dev-master": "3.7-dev"
		}
	},
	"config": {
		"allow-plugins": {
			"phpstan/extension-installer": true
		}
	}
}
